# Build artifacts
/bin/*
*.prg
*.prg.debug.xml
*.iq
# ...except faces kept in-repo for easy sideload download
!/bin/flashtest.prg
!/bin/devface.prg
!/bin/two-worlds.prg
!/bin/two-worlds-v2.prg
!/bin/two-worlds-v2-diag.prg

# Developer keys — NEVER commit. Stored in ~/.ciq-keys/ (see scripts/gen-key.sh)
*.der
*.pem

# Simulator / tooling logs
*.log
sim.out
*.tmp

# OS / editor cruft
.DS_Store
*.swp

# Local SDK config (paths are machine-specific; see scripts/env.sh)
.sdk-path

# Python sandbox bytecode
__pycache__/
*.pyc
