<?xml version="1.0" encoding="utf-8"?>
<!--
  Persistent properties (the CIQ 2.x object store). Read/written via
  AppBase.getProperty/setProperty. Do NOT migrate to Application.Properties
  (CIQ 3.0+, unavailable on fr735xt).

  lat/lng : user-entered location for the sun-derived true-north marker (no GPS
            on a watch face at this API level). Unset (0,0) -> marker hidden.
            Defaults seeded to Portland OR for the sideloaded build (editable in
            Garmin Express, which can configure sideloaded apps).
-->
<properties>
    <property id="lat" type="float">45.512575</property>
    <property id="lng" type="float">-122.638737</property>
</properties>
