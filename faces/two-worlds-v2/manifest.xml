<?xml version="1.0"?>
<!--
  two-worlds V2 manifest — same "artificial" clock/readout chrome over an
  organic generative field, but the field is the MossGrove day-organism
  (core/src/genart/MossGrove.mc) instead of BioBloom. Shares the two-worlds
  resources (fonts, icon, settings) via the jungle resourcePath.
  Targets ONLY the Forerunner 735XT (fr735xt) at CIQ API 2.4.
-->
<iq:manifest xmlns:iq="http://www.garmin.com/xml/connectiq" version="3">
    <iq:application
        entry="TwoWorldsV2App"
        id="2c8f1a9b4e7d4c0fa1b2c3d4e5f60789"
        launcherIcon="@Drawables.LauncherIcon"
        minSdkVersion="2.4.0"
        name="@Strings.AppName"
        type="watchface">
        <iq:products>
            <iq:product id="fr735xt"/>
        </iq:products>
        <iq:permissions>
            <!-- Position.getInfo(): the last known GPS fix (core DataSource).
                 Without it the fr735xt hands a watch face NO position, not
                 even via Activity.Info.currentLocation (wrist, 2026-10). -->
            <iq:uses-permission id="Positioning"/>
        </iq:permissions>
        <iq:languages>
            <iq:language>eng</iq:language>
        </iq:languages>
    </iq:application>
</iq:manifest>
