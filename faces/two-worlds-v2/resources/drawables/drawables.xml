<?xml version="1.0" encoding="utf-8"?>
<!--
  Drawable resources.
  - LauncherIcon: required by the manifest.
  - Font* : custom bitmap glyph strips exported from the design (white glyphs on
    a transparent background, already palette-exact: pure #FFFFFF + transparent,
    no antialiasing, so monkeyc keys out transparency with no dithering). Blitted
    cell-by-cell via core StripGlyphs. See archive/docs/claude-design-handoff.md.
      FontTime  180x30, ten 18px 7-seg digits (0..9)
      FontColon 4x30,   the ":" glyph (two dots), drawn directly
      FontDow   126x10, seven 18px day sprites (SU MO TU WE TH FR SA)
      FontDate  60x10,  ten 6px day-of-month digits (0..9)
  - BreachText: "CONTAINMENT BREACH", 155x12, palette-exact amber (#FFAA00)
    on transparent, no antialiasing.
  - BreachCapL / BreachCapR: the striped tape ends (26x20 each, opaque
    black + amber), cut from the sandbox banner. GENERATED by sketches/breach_compare.py
    (its emit option); never edit by hand.
-->
<drawables>
    <bitmap id="LauncherIcon" filename="launcher_icon.png"/>
    <bitmap id="FontTime" filename="tw_time.png"/>
    <bitmap id="FontColon" filename="tw_colon.png"/>
    <bitmap id="FontDow" filename="tw_dow.png"/>
    <bitmap id="FontDate" filename="tw_date.png"/>
    <bitmap id="BreachText" filename="tw_breach.png"/>
    <bitmap id="BreachCapL" filename="tw_breach_l.png"/>
    <bitmap id="BreachCapR" filename="tw_breach_r.png"/>
</drawables>
