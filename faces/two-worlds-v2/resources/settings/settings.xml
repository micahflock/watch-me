<?xml version="1.0" encoding="utf-8"?>
<!--
  Settings UI (edited in Garmin Connect Mobile / Garmin Express). Maps friendly
  controls to the location properties used by the sun/north marker.
-->
<settings>
    <setting propertyKey="@Properties.lat" title="Latitude">
        <settingConfig type="numeric" min="-90.0" max="90.0"/>
    </setting>
    <setting propertyKey="@Properties.lng" title="Longitude">
        <settingConfig type="numeric" min="-180.0" max="180.0"/>
    </setting>
</settings>
