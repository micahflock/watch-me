# Release jungle for two-worlds-v2.
# Shared core source is pulled in via sourcePath concatenation (no barrels).
# Resources (fonts, launcher icon, settings) are SHARED with the two-worlds face
# via resourcePath, so the V2 face owns only its source.

project.manifest = manifest.xml

# Face source + ONLY the core files this face references. monkeyc has no
# dead-code elimination for unreferenced classes, and the whole PRG loads into
# the 64 KB app RAM on this device: pulling in all of core/src (as before)
# shipped V1's entire BioBloom/StrataField/Flock dead, which left the release
# face ~1.5 KB from Out Of Memory at the first per-tick allocation (2026-07
# sim probe, docs/memory-budget.md re-measure recipe).
# Paths are relative to this jungle file.
base.sourcePath = source;../../core/src/astro;../../core/src/data;../../core/src/debug;../../core/src/genart/GenArt.mc;../../core/src/genart/MossGrove.mc;../../core/src/genart/MossState.mc;../../core/src/glyph/StripGlyphs.mc;../../core/src/render/Compositor.mc

# Reuse the two-worlds resources (fonts, launcher icon, settings), plus V2's
# own (the CONTAINMENT BREACH text bitmap) so V1 does not ship it.
base.resourcePath = ../two-worlds/resources;resources
