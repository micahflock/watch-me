<?xml version="1.0"?>
<!--
  gpsprobe manifest — the "can a watch face see a position fix?" probe.

  Purpose: settle, on real hardware, what Toybox.Position hands a WATCH FACE on
  this device when no activity is running. The simulator answers
  QUALITY_NOT_AVAILABLE with a null position (its GPS is simply off), which
  cannot distinguish "the device never gives a watch face a fix" from "the sim
  has nothing cached" — and the whole GPS-icon / GPS-derived-location plan rests
  on that difference. See docs/gps-notes.md.

  This is the ONLY manifest in the repo that requests a permission: reading
  Position requires Positioning even for the cached last-known fix. The face is
  a throwaway diagnostic, not a design — delete it once the question is closed
  (or keep it the way flashtest is kept, as a hardware-truth probe).

  Targets ONLY the Forerunner 735XT at CIQ API 2.4 (docs/api-2.4-notes.md).
-->
<iq:manifest xmlns:iq="http://www.garmin.com/xml/connectiq" version="3">
    <iq:application
        entry="GpsProbeApp"
        id="0f1a57e57000000000000000000fee1e"
        launcherIcon="@Drawables.LauncherIcon"
        minSdkVersion="2.4.0"
        name="@Strings.AppName"
        type="watchface">
        <iq:products>
            <iq:product id="fr735xt"/>
        </iq:products>
        <iq:permissions>
            <iq:uses-permission id="Positioning"/>
        </iq:permissions>
        <iq:languages>
            <iq:language>eng</iq:language>
        </iq:languages>
    </iq:application>
</iq:manifest>
