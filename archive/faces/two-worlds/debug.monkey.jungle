# Debug + unit-test jungle for two-worlds.
# Adds the tests/ directory. Built WITHOUT monkeyc -r so (:debug) instrumentation
# compiles in and (:release) stubs drop out. Do not set excludeAnnotations here.

project.manifest = manifest.xml

# Face source + the release jungle's narrowed core file list + unit tests.
base.sourcePath = source;../../core/src/astro;../../core/src/data;../../core/src/debug;../../core/src/genart/GenArt.mc;../../core/src/genart/BioBloom.mc;../../core/src/genart/BioState.mc;../../core/src/glyph/StripGlyphs.mc;../../core/src/render/Compositor.mc;tests

base.resourcePath = resources
