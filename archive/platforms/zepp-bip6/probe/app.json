  "targets": {
    "default": {
      "module": {
        "watchface": {
          "path": "watchface/index",
          "main": 1,
          "editable": 0,
          "lockscreen": 1
        }
      },
      "platforms": [
        {
          "deviceSource": 9765120
        },
        {
          "deviceSource": 9765121
        },
        {
          "deviceSource": 10158337
        }
      ],
      "designWidth": 390
    }
  },
  "i18n": {
    "en-US": {
      "appName": "MossProbe"
    }
  },
  "defaultLanguage": "en-US"
